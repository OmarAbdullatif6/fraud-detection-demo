# Prior Labs TabPFN Cloud API Token (Get a free API key at https://platform.priorlabs.ai/account/api-keys)
TABPFN_TOKEN=

# (Optional) Dataset context configuration
# Configure fraud vs non-fraud rows to sample (default: 10 fraud and 5000 non-fraud)
TABPFN_CONTEXT_CSV=../fraudTest.csv
TABPFN_FRAUD_ROWS=10
TABPFN_LEGITIMATE_ROWS=5000
TABPFN_CONTEXT_ROWS=5010

# (Optional) Only used if running local weights without API key
TABPFN_MODEL_PATH=Model/tabpfn-v3.5-20260909.safetensors
TABPFN_DEVICE=auto

